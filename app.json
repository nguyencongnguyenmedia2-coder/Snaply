{
  "expo": {
    "name": "Snaply",
    "slug": "snaply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snaply",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snaply.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Snaply cần quyền truy cập camera để bạn chụp ảnh và chia sẻ khoảnh khắc với bạn bè.",
        "NSPhotoLibraryUsageDescription": "Snaply cần quyền truy cập thư viện ảnh để bạn chọn và lưu ảnh kỷ niệm.",
        "NSPhotoLibraryAddUsageDescription": "Snaply cần quyền lưu khoảnh khắc vào thư viện ảnh của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.snaply.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Snaply chụp ảnh để chia sẻ khoảnh khắc với bạn bè."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Snaply truy cập thư viện ảnh để chia sẻ kỷ niệm."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF806E"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.snaply.app.widgets",
          "groupIdentifier": "group.com.snaply.app",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "SnaplyLatestWidget",
              "displayName": "Snaply Khoảnh Khắc Mới Nhất",
              "description": "Xem khoảnh khắc ảnh mới nhất từ bạn thân trên màn hình chính.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "src/widgets/MOMOLatestWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 160,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "src/widgets/MOMOLatestWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
