{
  "expo": {
    "name": "MOMO",
    "slug": "momo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.momo.moments",
      "infoPlist": {
        "NSCameraUsageDescription": "MOMO needs camera access so you can capture intimate real-life moments to share with your friends and home-screen widgets.",
        "NSPhotoLibraryUsageDescription": "MOMO needs photo library access so you can select and save personal memories.",
        "NSPhotoLibraryAddUsageDescription": "MOMO needs permission to save moments into your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.momo.moments",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MOMO to capture moments for your friends and widgets."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MOMO to access photos for memories and sharing."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF806E"
        }
      ],
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
